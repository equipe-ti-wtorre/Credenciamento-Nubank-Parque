# ===========================================
# OpenWA - configuração para o Credenciamento
# (baseado no .env.minimal do projeto OpenWA)
# ===========================================
# Copie para /www/wwwroot/openwa/.env (o install.sh faz isso se ainda não existir).

# Servidor. ATENÇÃO: o OpenWA escuta em todas as interfaces (não honra HOST/BIND_HOST fora do
# docker compose). Bloqueie a porta externamente no firewall — veja README.md.
# O backend do Credenciamento acessa via http://127.0.0.1:2785.
PORT=2785
NODE_ENV=production
BASE_URL=http://127.0.0.1:2785

# Volta a conectar sozinho as sessões já pareadas após restart do PM2.
AUTO_START_SESSIONS=true

# Banco embutido (SQLite) — sem Postgres/Redis/MinIO.
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Engine whatsapp-web.js (Chromium headless; menor risco de restrição do número).
ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# Guardrails de envio recomendados pelo OpenWA.
SIMULATE_TYPING=true
SEND_PACING_ENABLED=true

# Webhooks (não usados nesta fase, mas mantidos com defaults).
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_DELAY=5000

# Mídia em disco local.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Sem Redis / fila / cache.
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false

# Swagger desligado em produção (habilite temporariamente se precisar inspecionar a API).
ENABLE_SWAGGER=false
