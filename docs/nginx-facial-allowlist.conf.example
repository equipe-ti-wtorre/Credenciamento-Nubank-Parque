# Allowlist HTTP poll facial — Nginx (Credenciamento)
#
# Substitua:
#   ORIGIN_IP  → FACIAL_PEER_ORIGIN_IP  (IP público de saída / NAT do Gateway)
#   DESTINO_IP → FACIAL_PEER_DESTINATION_IP (opcional no listen se o vhost já escuta *:443)
#
# Regras:
#   - location =  EXATO nos quatro paths de integração
#   - NÃO use prefixo em /api/facial/status — bloquearia o JWT em
#     /api/v1/facial/status/ingest
#   - proxy_pass para 127.0.0.1:3007 (PORT padrão deste repo)
#   - manter X-Forwarded-For / X-Real-IP (Node usa trust proxy)

server {
    listen 443 ssl http2;
    # listen DESTINO_IP:443 ssl http2;
    server_name credenciamento.seu-dominio.com;

    # --- Integração Gateway (IP pin) ---

    location = /api/facial/events {
        allow ORIGIN_IP;
        deny all;
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
        proxy_read_timeout 120s;
    }

    location = /api/facial/status {
        allow ORIGIN_IP;
        deny all;
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
        proxy_read_timeout 120s;
    }

    location = /api/facial/jobs/claim {
        allow ORIGIN_IP;
        deny all;
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
        proxy_read_timeout 120s;
    }

    location = /api/facial/jobs/queued {
        allow ORIGIN_IP;
        deny all;
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
        proxy_read_timeout 120s;
    }

    # Health, login, admin JWT, SPA API
    location /api/ {
        proxy_pass http://127.0.0.1:3007/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
        proxy_read_timeout 120s;
    }
}
